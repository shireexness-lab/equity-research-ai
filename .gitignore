# ห้ามให้ไฟล์เหล่านี้ขึ้น GitHub เด็ดขาด
# (เพราะ Streamlit Cloud ฟรีบังคับให้ repo เป็น public = คนทั้งโลกเห็นโค้ด)

# ความลับ — สำคัญที่สุด
.streamlit/secrets.toml
.env
*.key

# กุญแจ Google Drive — ถ้าหลุดขึ้น GitHub คนอื่นจะเขียนไฟล์ใน Drive ได้
gdrive_service_account.json
*service_account*.json
*credentials*.json

# ห้องแยกของ Python
.venv/
venv/
__pycache__/
*.pyc

# ข้อมูลที่ดึงมา (ดึงใหม่ได้เสมอ ไม่ต้องเก็บใน git)
cache/
output/

# ขยะของ Mac
.DS_Store
